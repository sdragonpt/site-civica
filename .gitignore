# Cívica Equipamentos — .gitignore

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
error_log
access_log

# Backup files
*.bak
*.backup
*.orig

# Environment / secrets
.env
.env.local
.env.production

# Node (if ever used locally)
node_modules/
package-lock.json

# Build artifacts
dist/
build/

# Local documentation (don't commit this to public repo)
# Uncomment the line below if you don't want the readme in GitHub
# LEIA-ME.md

# Database config — NEVER commit this
api/config.php

# Setup script — delete after first run
api/setup.php
